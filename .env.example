# --- Frontend (Vite) ---
# Address of the deployed TradingVault contract.
VITE_VAULT_ADDRESS=
# EVM chain ID where the vault is deployed (11155111 = Sepolia, 42161 = Arbitrum, 1 = Mainnet).
VITE_VAULT_CHAIN_ID=11155111
# Address of the underlying asset (USDC) on that chain.
VITE_VAULT_ASSET=
# Decimals of the underlying asset (USDC = 6).
VITE_VAULT_ASSET_DECIMALS=6
# Symbol shown in the UI.
VITE_VAULT_ASSET_SYMBOL=USDC
# Optional: WalletConnect projectId. Get one from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# --- Hardhat (deployment) ---
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ETHERSCAN_API_KEY=
